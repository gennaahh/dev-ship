{
  "name": "@dev-city/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "auth:schema": "bunx --bun auth@1.7.7 generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  }
}
