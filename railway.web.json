{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.web",
    "watchPatterns": [
      "/src/**",
      "/index.html",
      "/vite.config.js",
      "/packages/shared/**",
      "/Dockerfile.web",
      "/Caddyfile.web",
      "/railway.web.json",
      "/package.json",
      "/bun.lock",
      "/apps/api/package.json",
      "/apps/game/package.json"
    ]
  }
}
