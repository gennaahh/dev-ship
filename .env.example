# Copiare in .env (che non va in git): lo leggono API e game server avviati con bun run.
# Tutte le variabili sono facoltative in sviluppo: i default corrispondono a
# docker-compose.yml e alle porte di bun run dev:all. In produzione l'API si ferma
# all'avvio se mancano DATABASE_URL, BETTER_AUTH_SECRET, GITHUB_CLIENT_ID o GITHUB_CLIENT_SECRET.

# --- Servizi (docker-compose.yml)
DATABASE_URL=postgres://devcity:devcity@localhost:5432/devcity
# Per il game server: con più processi (vedi sotto) e per tenere lo storico della chat
# anche quando la stanza si chiude o il server si riavvia. Senza, lo storico sta in memoria.
# REDIS_URL=redis://localhost:6379

# --- API (apps/api)
# Indirizzo pubblico dell'API: emittente dei token per le stanze.
API_URL=http://localhost:3000
# Origini del frontend ammesse, separate da virgola. Se manca, in sviluppo vale qualsiasi
# pagina sulla porta di Vite (5173), anche dall'IP della rete locale.
# WEB_ORIGINS=https://dev-ship.netlify.app
# Almeno 32 caratteri. In produzione: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Login con GitHub: crea una OAuth App su https://github.com/settings/developers con
# "Authorization callback URL" = <API_URL>/api/auth/callback/github
# (in sviluppo http://localhost:3000/api/auth/callback/github). In produzione sono obbligatorie;
# in sviluppo si può anche entrare solo con un nome ("Entra (dev)"), senza GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Game server (apps/game)
# Il game server usa API_URL per scaricare le chiavi pubbliche dei token.
# Con REDIS_URL più processi condividono matchmaking e presenza; ognuno ha bisogno del
# proprio PUBLIC_ADDRESS (host:porta). Lasciare commentato per un solo processo in memoria.
# PUBLIC_ADDRESS=localhost:2567
# Il game server salva le catture della pesca nello stesso DATABASE_URL dell'API.
# Per provare la pesca senza aspettare: abbocca dopo 10-20 secondi invece che 10-20 minuti.
# FISHING_FAST=1
# Per provare la miniera senza aspettare: una pietra ogni 4-6 secondi invece che minuti, una
# scoperta ogni 15-25 secondi.
# MINING_FAST=1
